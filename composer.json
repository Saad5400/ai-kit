{
    "name": "saad/ai-kit",
    "description": "Shared AI infrastructure for catodemy, s-grade and uqucc: OpenRouter gateway, conversations, streaming, approvals, usage metering, model catalog, RAG and credits.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["laravel", "ai", "mcp", "openrouter"],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.62|^13.15",
        "illuminate/database": "^12.62|^13.15",
        "illuminate/support": "^12.62|^13.15",
        "laravel/ai": "^1.0",
        "laravel/mcp": "^1.0",
        "symfony/process": "^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Saad\\AiKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Saad\\AiKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Saad\\AiKit\\AiKitServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint --test",
        "fix": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
